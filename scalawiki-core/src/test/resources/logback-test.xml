<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true">

<!--  <conversionRule conversionWord="traceToken" converterClass="kamon.trace.logging.LogbackTraceTokenConverter"/> -->

    <!-- Enable JMX access; which allows us to change logging at runtime -->
    <jmxConfigurator />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.out</target>
        <encoder>
            <pattern>%date{MM/dd HH:mm:ss} %-5level[%.15thread] %logger{1} %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Pekko is wired to slf4j in main/resources/application.conf, so MwBot.log
         (logger org.apache.pekko.actor.ActorSystemImpl) and Pekko internals now
         reach logback in tests too. Keep the per-request GET/POST chatter off the
         console, matching the other modules' logback-test.xml. -->
    <logger name="org.apache.pekko" level="WARN"/>
    <logger name="org.mockserver" level="${mockserver.logLevel:-WARN}"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>